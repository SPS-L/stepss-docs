---
// Starlight's social icons, preceded by the label naming the STEPSS release
// this site documents. The header shows this component on wide screens and the
// mobile menu shows it at the bottom, so the label is on every page in both.
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { STEPSS_VERSION, RELEASE_URL } from '../version.mjs';
---

<a
	class="docs-version"
	href={RELEASE_URL}
	title={`This documentation covers STEPSS ${STEPSS_VERSION}. Open the release notes.`}
>
	<span class="sr-only">Documentation for STEPSS </span>v{STEPSS_VERSION}
</a>
<Default><slot /></Default>

<style>
	.docs-version {
		align-self: center;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-accent-high);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		line-height: 1.4;
		text-decoration: none;
		white-space: nowrap;
	}
	.docs-version:hover {
		border-color: var(--sl-color-accent-high);
	}
</style>
